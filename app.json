{
  "id": "com.trmnl.companion",
  "version": "0.2.2",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "TRMNL"
  },
  "description": {
    "en": "Push your Homey's energy, climate and home status to a TRMNL e-ink display."
  },
  "category": [
    "tools"
  ],
  "tags": {
    "en": [
      "TRMNL",
      "e-ink",
      "eink",
      "e-paper",
      "display",
      "dashboard",
      "screen",
      "energy",
      "climate"
    ]
  },
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "diag": {
      "method": "GET",
      "path": "/diag"
    },
    "pushNow": {
      "method": "POST",
      "path": "/push"
    }
  },
  "brandColor": "#F8654B",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "TRMNL",
    "email": "support@trmnl.com",
    "website": "https://trmnl.com"
  },
  "homepage": "https://trmnl.com/integrations/homey",
  "support": "https://help.trmnl.com",
  "source": "https://github.com/usetrmnl/trmnl-homey-app",
  "bugs": {
    "url": "https://github.com/usetrmnl/trmnl-homey-app/issues"
  }
}