{
  "id": "com.trmnl.companion",
  "version": "0.1.3",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "TRMNL"
  },
  "description": {
    "en": "Push your Homey's energy, climate and home status to a TRMNL e-ink display."
  },
  "category": [
    "tools"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "diag": {
      "method": "GET",
      "path": "/diag"
    },
    "pushNow": {
      "method": "POST",
      "path": "/push"
    }
  },
  "brandColor": "#000000",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "TRMNL"
  }
}
